---
const { title, description = 'Product designer portfolio.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="storm" aria-hidden="true"></div>
    <header class="nav">
      <a class="logo" href="/">Olena</a>
      <nav>
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="https://github.com/" rel="noopener">GitHub</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="foot">© {new Date().getFullYear()} · Built with Astro · <a href="https://github.com/">Source on GitHub</a></footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0d1a;
    --bg-2: #141833;
    --text: #e8eaf6;
    --muted: #9aa0c3;
    --accent: #f5c94c;
    --line: rgba(255, 255, 255, 0.1);
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) {
      --bg: #0b0d1a; /* storm theme stays dark by design */
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 400 17px/1.6 Inter, system-ui, sans-serif;
    min-height: 100vh;
  }
  .storm {
    position: fixed; inset: 0; z-index: -1;
    background:
      radial-gradient(60% 40% at 80% 0%, rgba(120, 90, 255, 0.28), transparent 70%),
      radial-gradient(50% 40% at 10% 20%, rgba(60, 120, 255, 0.18), transparent 70%),
      var(--bg);
  }
  a { color: inherit; }
  main, .nav, .foot { max-width: 960px; margin: 0 auto; padding: 0 16px; }
  .nav { display: flex; justify-content: space-between; align-items: center; padding-top: 24px; padding-bottom: 24px; }
  .nav nav { display: flex; gap: 20px; font-size: 15px; }
  .nav a { text-decoration: none; color: var(--muted); }
  .nav a:hover, .nav .logo { color: var(--text); }
  .logo { font-family: Fraunces, serif; font-size: 20px; font-weight: 600; }
  h1, h2 { font-family: Fraunces, serif; font-weight: 600; line-height: 1.1; margin: 0; }
  .foot { color: var(--muted); font-size: 14px; padding-top: 64px; padding-bottom: 40px; }
</style>
